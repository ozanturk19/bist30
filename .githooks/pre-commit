#!/bin/bash
# .githooks/pre-commit
# KALICI_KURALLAR v1.1 otomatik audit — CPO-359 Tier 0 standardı
# Bu hook AUDIT_FILES listesindeki dosyalardan biri değiştiğinde KK audit çalıştırır.
# Audit FAIL ise commit blokla.
#
# CPO-1109 madde 3: kapsam sadece hisse.html'di, karsilastir.html'deki 🥇
# ihlali kaçmıştı. Liste, sinyal/skor/trend metni render eden tüm sayfaları
# kapsayacak şekilde genişletildi (bkz. DEV-1467).
#
# CPO-1111: 4 dosyadan genişletildi — bugün temiz olan sayfaların
# yarın sessizce kirlenmesini önlemek için (regresyon kapısı kapsamı).
# heatmap.html CPO-1111'de istenen 5. dosyaydı ama K1 (bp-main-nav) fail
# veriyor — full-bleed treemap sayfası, standart nav yerine kendi minimal
# header'ı var (bkz. DEV-1468). Tasarım kararı CPO'ya soruldu, o karara
# kadar dışarıda tutuldu.
#
# CPO-1584 (11.09): liste 8 dosyadan sinyal/trend içeriği taşıyan TÜM
# şablonlara genişletildi — build_signal_summary()'deki (app.py) Alış/
# Satış sızıntısını (CPO-1583) tespit ettikten sonra DEV1 bu kapsam
# boşluğunu bağımsız doğruladı (DEV-1866): index.html/portfolio.html/
# gundem.html/metodoloji.html/blog.html/blog_article.html/temettu_
# takvimi.html/bilanco_takvimi.html hiç taranmıyordu. Hepsinde bp-main-nav
# var (K1 fail riski yok, doğrulandı). Ölü `gucu_yuksek.html` girdisi
# kaldırıldı (dosya artık repoda yok, sessiz no-op'tu).
# app.py'nin kendisi (K3'ün gerçek kaynağı olan build_signal_summary
# gibi Python string üreticileri) hâlâ BU gate'in kapsamı DIŞINDA —
# grep deseni template'lere özgü, ayrı bir Python-taramalı kural
# gerekir, backlog'da (bkz. project_sinyal_ozeti_alis_satis_sizinti_11_09).
#
# Kurulum: git config core.hooksPath .githooks (bir kez)

set -e
AUDIT_FILES="templates/hisse.html templates/karsilastir.html templates/ozet.html templates/sektor_harita.html templates/tarama.html templates/hisseler.html templates/sinyal_performans.html templates/index.html templates/portfolio.html templates/gundem.html templates/metodoloji.html templates/blog.html templates/blog_article.html templates/temettu_takvimi.html templates/bilanco_takvimi.html"

CHANGED=""
for f in $AUDIT_FILES; do
  if git diff --cached --name-only --diff-filter=ACM | grep -qxF "$f"; then
    CHANGED="$CHANGED $f"
  fi
done
if [ -z "$CHANGED" ]; then
  exit 0  # audit kapsamındaki dosyalar değişmedi
fi

echo ""
echo "🔍 KALICI_KURALLAR v1.1 pre-commit audit..."
echo ""
FAIL=0
for f in $CHANGED; do
  if ! ./tests/audit/kalici-kurallar-check.sh "$f"; then
    FAIL=1
  fi
  echo ""
done

if [ "$FAIL" = "0" ]; then
  echo "✅ Commit izinli."
  exit 0
else
  echo "❌ Commit blokladı. KALICI_KURALLAR ihlali var. Düzelt ve tekrar dene."
  echo "   Geçici by-pass için: git commit --no-verify (önerilmez)"
  exit 1
fi
