[Unit]
Description=BorsaPusula EOD retry oneshot — yalnız catch-up + resmi kapanış denemesi (D-27 / A3)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bist30
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/bist30/venv/bin/python3 -m pipeline.eod run --only-missing
TimeoutStartSec=600
StandardOutput=append:/var/log/bp-eod.log
StandardError=append:/var/log/bp-eod.log
